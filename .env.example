# Blind Insight credentials — the Python client authenticates every HTTP request
# with basic auth from these values. Copy to .env and fill in.
#
# Note: this is SEPARATE from `./blind login`, which configures the proxy CLI and
# keyring (the encryption keys). You need both.
BI_EMAIL=you@example.com
BI_PASSWORD=your-password
BI_ORG=your-org-slug

# Blind Proxy endpoint (default: https://local.blindinsight.io)
BI_PROXY_URL=https://local.blindinsight.io

# The local proxy uses a self-signed cert; leave false unless you have a valid one.
BI_VERIFY_SSL=false

# Which dataset/schema BIStatsSession queries. Optional overrides — these win over
# BI_DATASET / BI_SCHEMA, which in turn win over get_demo_config().
BI_STATS_DATASET=stats-demo
BI_STATS_SCHEMA=stats-fraud-290
